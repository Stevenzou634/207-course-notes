@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

' Your task (Chapter 8, Question 1): draw the UML class diagram for the library
' specification — items, books, DVDs, reference-only items, members, librarians,
' and holds.
'
' Define each type as a box, then connect them with the right arrows. One box
' (Item) is filled in as an example — decide on the rest yourself. There is more
' than one defensible answer.
'
' PlantUML cheat-sheet:
'   interface Name { + method() : Type }
'   abstract class Name { # field : Type }
'   class Name { - field : Type }
'   Parent    <|-- Child    ' generalization: Child extends Parent
'   Interface <|.. Class    ' realization:    Class implements Interface
' (Putting the parent/interface on the LEFT of the arrow keeps it on top, which
'  is the convention used in these notes.)

abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}

' Only some items can be borrowed, so borrowing lives in an interface
interface Borrowable {
  + getLoanPeriodDays() : int
  + isOnLoan() : boolean
  + borrow(member : Member) : void
  + returnItem() : void
}

class Book {
  - onLoan : boolean
  + getLoanPeriodDays() : int
  + isOnLoan() : boolean
  + borrow(member : Member) : void
  + returnItem() : void
}

class DVD {
  - onLoan : boolean
  + getLoanPeriodDays() : int
  + isOnLoan() : boolean
  + borrow(member : Member) : void
  + returnItem() : void
}

class ReferenceItem {
}

class Catalogue {
  - items : List<Item>
  + addItem(item : Item) : void
  + findItem(catalogueNumber : String) : Item
}

abstract class LibraryUser {
  - name : String
  + getName() : String
}

class Member {
  - memberNumber : String
  - lateFee : double
  + logIn(memberNumber : String) : boolean
  + placeHold(item : Borrowable) : Hold
  + getLateFee() : double
  + setLateFee(fee : double) : void
}

class Librarian {
  + addItem(catalogue : Catalogue, item : Item) : void
  + waiveLateFee(member : Member) : void
}

class Hold {
  - member : Member
  - item : Borrowable
  + getMember() : Member
  + getItem() : Borrowable
}

Item <|-- Book
Item <|-- DVD
Item <|-- ReferenceItem
Borrowable <|.. Book
Borrowable <|.. DVD

LibraryUser <|-- Member
LibraryUser <|-- Librarian

Catalogue "1" o-- "*" Item
Librarian --> Catalogue : adds items to
Librarian --> Member : waives late fee of
Member "1" --> "*" Hold : places
Hold "*" --> "1" Borrowable : on

@enduml
